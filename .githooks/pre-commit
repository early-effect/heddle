#!/usr/bin/env bash
# Reject commits that fail the Histos formatting gate.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
if [[ ! -x ./histos ]]; then
  echo "pre-commit: executable ./histos not found; cannot check formatting" >&2
  exit 1
fi
echo "pre-commit: running ./histos fmt --check"
if ! ./histos fmt --check; then
  echo >&2
  echo "pre-commit: BLOCKED; ./histos fmt --check failed." >&2
  echo "  Fix with: ./histos fmt && git add -u" >&2
  echo "  Then commit again." >&2
  exit 1
fi
echo "pre-commit: OK; ./histos fmt --check passed."
